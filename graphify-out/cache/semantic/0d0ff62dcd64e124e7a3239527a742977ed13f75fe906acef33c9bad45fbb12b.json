{"nodes": [{"id": "plan_markitdown_document", "label": "Markitdown Integration Plan \u2014 TalentOS", "file_type": "document", "source_file": "PLAN_markitdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_markitdown_uploadflowbroken", "label": "Broken Upload Flow Problem (pdf-parse Node-only)", "file_type": "rationale", "source_file": "PLAN_markitdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pdf-parse is Node.js-only and breaks on Cloudflare Workers; the current extractText() using Buffer.from() and pdf-parse is unreliable, and SharePoint upload errors are swallowed instead of shown to the user."}, {"id": "plan_markitdown_architecturedecision", "label": "Separate Python Markitdown Microservice Decision", "file_type": "rationale", "source_file": "PLAN_markitdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Markitdown requires Python and has no JS equivalent of the same quality; TalentOS is TypeScript/Next.js deployed to Cloudflare Workers (edge runtime, no Python), so a separate stateless HTTP microservice is standard microservices architecture rather than trying to run Python on the edge."}, {"id": "plan_markitdown_tokensavings", "label": "Token Savings from Markdown vs Raw Text Parsing", "file_type": "rationale", "source_file": "PLAN_markitdown.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw extracted text is noisy and loses formatting, costing ~3000-5000 tokens per resume parse; markdown is cleaner for AI parsing, reducing cost to ~1500-2500 tokens \u2014 an estimated 40-50% token savings per resume parse."}], "edges": [{"source": "plan_markitdown_document", "target": "plan_markitdown_uploadflowbroken", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_markitdown.md", "source_location": null, "weight": 1.0}, {"source": "plan_markitdown_document", "target": "plan_markitdown_architecturedecision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_markitdown.md", "source_location": null, "weight": 1.0}, {"source": "plan_markitdown_document", "target": "plan_markitdown_tokensavings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_markitdown.md", "source_location": null, "weight": 1.0}, {"source": "plan_markitdown_document", "target": "services_markitdown_readme_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_markitdown.md", "source_location": null, "weight": 1.0}, {"source": "plan_markitdown_document", "target": "services_markitdown_requirements_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PLAN_markitdown.md", "source_location": null, "weight": 1.0}, {"source": "plan_markitdown_document", "target": "debug_linkedin_url_seeding_document", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "PLAN_markitdown.md", "source_location": null, "weight": 1.0}, {"source": "plan_markitdown_document", "target": "debug_base_resume_load_loop_document", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "PLAN_markitdown.md", "source_location": null, "weight": 1.0}], "hyperedges": []}